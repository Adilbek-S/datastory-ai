# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB (локальное хранилище для RAG)
CHROMA_DIR=data/chroma

# Рабочее хранилище подтверждённых датасетов
WORKSPACE_DIR=data/workspace

# LangSmith (необязательно — трассировка запросов)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=datastory-ai
