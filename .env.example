# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# auto: OpenAI при заданном ключе, иначе офлайн-режим (лексический поиск); openai | offline — принудительно
EMBEDDING_PROVIDER=auto

# ChromaDB (локальное хранилище для RAG)
CHROMA_DIR=data/chroma

# Рабочее хранилище подтверждённых датасетов
WORKSPACE_DIR=data/workspace

# Каталог Skill с методикой анализа (datastory-analysis/SKILL.md); загружается LLM-этапами воркфлоу
SKILLS_DIR=.claude/skills

# MCP-сервер аналитических инструментов (запускается приложением как дочерний процесс)
MCP_SERVER_MODULE=datastory.mcp_server.server
MCP_STARTUP_TIMEOUT=30
MCP_CALL_TIMEOUT=60

# LangSmith (необязательно — трассировка запросов)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=datastory-ai
